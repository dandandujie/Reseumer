{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "paths": {
      "@/*": ["./src/*"],
      "next-intl": ["./src/i18n/compat-next-intl.ts"],
      "next-auth/react": ["./src/compat/next-auth-react.ts"],
      "next/image": ["./src/compat/next-image.ts"],
      "next/navigation": ["./src/compat/next-navigation.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.mts",
    "vite-env.d.ts"
  ],
  "exclude": ["node_modules", "src-tauri"]
}
